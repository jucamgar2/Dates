---
import Layout from "../layouts/Layout.astro";

let anniversary = new Date('2024-12-14T19:00:00');
let today = new Date();

let miles = (today.getTime() - anniversary.getTime()) / 1000;
let days = Math.floor(miles/3600/24);
let hours = Math.floor(miles/3600)%24;
let minutes = Math.floor(miles/60)%60;
let seconds = Math.floor(miles%60);

let totalDays = Math.floor(miles/3600/24);
let totalHours = totalDays*24+hours;
let totalMinutes = totalHours*60;
---

<Layout>
    <div class="timer">
        <h1>Contador del tiempo que llevamos juntos</h1>
        <div class="text">
            <span class="number" id="days">{days}</span><span class="label">días</span>
            <span class="number" id="hours">{hours}</span><span class="label">horas</span>
            <span class="number" id="minutes">{minutes}</span><span class="label">minutos</span>
            <span class="number" id="seconds">{seconds}</span><span class="label">segundos</span>
        </div>
        
        <div class="text">
            <span class="label">Un total de </span><span class="number" id="totalDays">{totalDays}</span><span class="label"> días</span>
        </div>
        <div class="text">
            <span class="label">Un total de </span><span class="number" id="totalHours">{totalHours}</span><span class="label"> horas</span>
        </div>
        <div class="text">
            <span class="label">Un total de </span><span class="number" id="totalMinutes">{totalMinutes}</span><span class="label"> minutos</span>
        </div>
    </div>

    <script>
      const anniversary = new Date('2024-12-14T19:00:00');
      function updateCountdown() {
        const now = new Date();
        const miles = (now.getTime() - anniversary.getTime()) / 1000;
        const days = Math.floor(miles/3600/24);
        const hours = Math.floor(miles/3600)%24;
        const minutes = Math.floor(miles/60)%60;
        const seconds = Math.floor(miles%60);
        const totalDays = Math.floor(miles/3600/24);
        const totalHours = totalDays * 24 + hours;
        const totalMinutes = totalHours * 60;

        document.getElementById('days').textContent = days;
        document.getElementById('hours').textContent = hours;
        document.getElementById('minutes').textContent = minutes;
        document.getElementById('seconds').textContent = seconds;
        document.getElementById('totalDays').textContent = totalDays;
        document.getElementById('totalHours').textContent = totalHours;
        document.getElementById('totalMinutes').textContent = totalMinutes;
      }
      setInterval(updateCountdown, 1000);
      updateCountdown(); 
    </script>

</Layout>

<style>
    .timer {
        margin: 0 20%;
        text-align: center;
    }

    .text {
        display: flex;
        justify-content: center;
        align-items: baseline;
        gap: 12px;
        font-size: 50px;
        font-weight: bold;
    }

    .number {
        color: #ff4d6d;
    }

    .label {
        font-size: 22px;
        font-weight: normal;
        margin-right: 10px;
    }

    @media (max-width: 768px) {
        .timer {
            margin: 0 0%;
            text-align: center;
        }

        .text{
            display: block;
        }

    }
</style>